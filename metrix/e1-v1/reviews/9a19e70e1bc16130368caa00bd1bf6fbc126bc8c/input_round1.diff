new file mode 100644
index 0000000..159f198
--- /dev/null
+++ b/metrix/e1-v1/reports/freeze/hash_invariance.py
@@ -0,0 +1,15 @@
+"""Compare every 40/64-hex string (hashes, revisions, commits) in the protocol and the four JSON files at a base commit
+with those at a target tree-ish; report strings only in one side. Usage: hash_invariance.py <base> <target>"""
+import re, subprocess, sys
+base, target = sys.argv[1], sys.argv[2]
+FILES = ["METRIX_E1V1_PROTOCOL.md", "DATA_MANIFEST.json", "SPLIT_MANIFEST.json", "DOSE_SPACE.json", "DAMAGE_MANIFEST.json"]
+rx = re.compile(r"(?<![0-9a-f])(?:[0-9a-f]{64}|[0-9a-f]{40})(?![0-9a-f])")
+def show(rev, f):
+    return subprocess.run(["git", "show", f"{rev}:metrix/e1-v1/{f}"], capture_output=True, check=True, text=True).stdout
+ok = True
+for f in FILES:
+    a, b = show(base, f), show(target, f)
+    A, B = set(rx.findall(a)), set(rx.findall(b))
+    print(f"{f}: base {len(A)} distinct hex strings, target {len(B)}; only in base: {sorted(A - B)}; only in target: {sorted(B - A)}")
+    ok &= (A == B)
+print("RESULT:", "SAME hex-string sets in all five files" if ok else "DIFFERENT")
diff --git a/metrix/e1-v1/reports/freeze/rebuild_check.sh b/metrix/e1-v1/reports/freeze/rebuild_check.sh
new file mode 100755
index 0000000..44360c0
--- /dev/null
+++ b/metrix/e1-v1/reports/freeze/rebuild_check.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Usage: rebuild_check.sh <tree-ish>   (run from the repository root)
+# Exports the tree-ish, deletes the four JSON files, regenerates them with build_manifests.py, and compares the
+# regenerated bytes with the blobs of the tree-ish.
+set -u
+REV=$1
+D=$(mktemp -d "${TMPDIR:-/tmp}/rebuild.XXXXXX")
+echo "\$ date -u"; date -u +%Y-%m-%dT%H:%M:%SZ
+echo "\$ git rev-parse $REV"; git rev-parse "$REV"
+echo "\$ git archive $REV metrix/e1-pilot/DATA_MANIFEST.json metrix/e1-pilot/SPLIT_MANIFEST.json metrix/e1-v1 | tar -x -C <tmp>"
+git archive "$REV" metrix/e1-pilot/DATA_MANIFEST.json metrix/e1-pilot/SPLIT_MANIFEST.json metrix/e1-v1 | tar -x -C "$D"
+cd "$D"
+echo "\$ rm metrix/e1-v1/{DATA,SPLIT,DAMAGE}_MANIFEST.json metrix/e1-v1/DOSE_SPACE.json"
+rm metrix/e1-v1/DATA_MANIFEST.json metrix/e1-v1/SPLIT_MANIFEST.json metrix/e1-v1/DOSE_SPACE.json metrix/e1-v1/DAMAGE_MANIFEST.json
+echo "\$ python3 metrix/e1-v1/reports/authoring/build_manifests.py   ($(python3 --version))"
+python3 metrix/e1-v1/reports/authoring/build_manifests.py; echo "exit=$?"
+cd - >/dev/null
+fail=0
+for f in DATA_MANIFEST.json SPLIT_MANIFEST.json DOSE_SPACE.json DAMAGE_MANIFEST.json; do
+  a=$(git cat-file blob "$REV:metrix/e1-v1/$f" | sha256sum | cut -d' ' -f1)
+  b=$(sha256sum "$D/metrix/e1-v1/$f" | cut -d' ' -f1)
+  if git cat-file blob "$REV:metrix/e1-v1/$f" | cmp -s - "$D/metrix/e1-v1/$f"; then r=IDENTICAL; else r=DIFFERENT; fail=1; fi
+  echo "$f  committed $a  regenerated $b  $r"
+done
+echo "RESULT: $([ $fail = 0 ] && echo 'all four regenerated JSON files are byte-identical to the tree-ish' || echo FAIL)"
+rm -rf "$D"
