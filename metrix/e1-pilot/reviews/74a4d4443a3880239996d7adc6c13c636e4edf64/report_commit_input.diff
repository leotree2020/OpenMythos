++def passing(c):
++    g = c.gate
++    mid = lambda iv: (iv[0] + iv[1]) / 2                       # noqa: E731
++    return {
++        "G0.1": {"leakage_result": "PASS", "over_limit": []},
++        "G0.2": {"all_finite": True, "nonfinite": []},
