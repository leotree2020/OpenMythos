++    want = ["model.layers.%d.%s.%s" % (i, p, n) for i in range(3)
++            for n, p in [(n, "self_attn") for n in ("q_proj", "k_proj", "v_proj", "o_proj")]
++            + [(n, "mlp") for n in ("gate_proj", "up_proj", "down_proj")]]
++    assert paths == want
++    for mod in m.modules():
