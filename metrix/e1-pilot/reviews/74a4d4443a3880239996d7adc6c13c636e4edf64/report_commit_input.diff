++"""Gate 0 of METRIX E1-PILOT: G0.1-G0.10 and the status words.
++
++Protocol v1.1 section 8 (Gate 0 table; "seed-average"; the notes under the table) and section 9 (the fixed status
++vocabulary and which reason belongs to which condition). Thresholds come from metrix_e1.contract (parsed from the
++frozen protocol text). Status words are only those of section 9 (errors.STATUSES); interpretation B14 covers what
++section 9 leaves open, B15 the meaning of G0.8's terms.
++
++compute_values() turns evaluations into the numbers each condition reads; judge() applies the thresholds. In smoke
++mode judge() computes everything but the Gate 0 status is fixed to NOT_TESTED with the note "冒烟测试，不构成结论"
++(Implementation Task Order V1, section 7).
++"""
++import math
++
++from . import stats as S
++from .errors import STATUSES
++from .mode import SMOKE_GATE_NOTE, SMOKE_LABEL
++
++CONDITIONS = ("G0.1", "G0.2", "G0.3", "G0.4", "G0.5", "G0.6", "G0.7", "G0.8", "G0.9", "G0.10")
++REASON = {"G0.1": "IMPLEMENTATION_FAIL", "G0.2": "IMPLEMENTATION_FAIL", "G0.6": "IMPLEMENTATION_FAIL",
++          "G0.7": "IMPLEMENTATION_FAIL", "G0.8": "IMPLEMENTATION_FAIL", "G0.4": "OPTIMIZATION_FAIL",
++          "G0.5": "OPTIMIZATION_OR_CAPACITY_UNRESOLVED", "G0.3": None, "G0.9": None, "G0.10": None}
++RECALIBRATION_NOTE = "越过 G0.3 或 G0.9 的界限不代表机制失败:它触发 benchmark 重新校准(新协议版本)"
++TOO_HARD_NOTE = "对该模型与该训练量过难"
