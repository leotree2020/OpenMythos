++# ------------------------------------------------------------------------------------------- arms (sections 4, 7)
++
++@dataclass(frozen=True)
++class Arms:
++    configs: dict                   # arm -> list of config dicts (F, L, A), in SEARCH_SPACE order
++    lora_modules: tuple             # q_proj, ...
++    lora_layers: int                # 28
++    lora_alpha_per_rank: float      # alpha = 2 * rank
++    lora_dropout: float
