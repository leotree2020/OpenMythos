++# --------------------------------------------------------------------------------------------- bootstrap unit
++
++def _facts(n_per_stratum=60):
++    out = []
++    for st in ("natural", "random"):
++        out += [{"fact_id": "%s-%02d" % (st, i), "stratum": st, "exposure": "learned"} for i in range(n_per_stratum)]
++    return out
