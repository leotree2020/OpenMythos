++class PreconditionFailed(Exception):
++    pass
++
++
++def _committed_json(repo_root, rel):
++    """JSON of a file that is committed at HEAD with no uncommitted change in the working tree."""
++    r = subprocess.run(["git", "-C", str(repo_root), "cat-file", "blob", "HEAD:%s" % rel], capture_output=True, check=False)
++    if r.returncode != 0:
++        raise PreconditionFailed("%s is not committed at HEAD" % rel)
++    wt = Path(repo_root) / rel
++    if not wt.is_file() or wt.read_bytes() != r.stdout:
++        raise PreconditionFailed("%s in the working tree differs from its committed version" % rel)
++    try:
++        return json.loads(r.stdout), FZ.sha256_hex(r.stdout)
++    except ValueError as e:
++        raise PreconditionFailed("%s does not parse: %r" % (rel, e)) from e
++
++
++def check_gate0_record(fz, repo_root):
++    """Condition 2."""
++    rel = "%s/%s" % (R.FORMAL_RESULTS_REL, R.GATE0_RECORD)
++    rec, sha = _committed_json(repo_root, rel)
++    if rec.get("mode") != "formal" or rec.get("label") is not None:
++        raise PreconditionFailed("%s is not a formal-mode record (mode %r)" % (rel, rec.get("mode")))
++    if rec.get("frozen_commit") != fz.record.commit:
++        raise PreconditionFailed("%s names frozen commit %r, PROTOCOL_FROZEN %s" % (rel, rec.get("frozen_commit"), fz.record.commit))
++    status = (rec.get("gate0") or {}).get("gate0_status")
++    if status != "PASS":
++        raise PreconditionFailed("%s: Gate 0 status %r, not PASS" % (rel, status))
++    return sha
++
++
++def check_selection_record(fz, contract, repo_root, content_hashes):
++    """Condition 3."""
++    rel = "%s/%s" % (R.FORMAL_RESULTS_REL, R.SELECTION_FREEZE_RECORD)
++    rec, sha = _committed_json(repo_root, rel)
++    if rec.get("mode") != "formal" or rec.get("label") is not None:
++        raise PreconditionFailed("%s is not a formal-mode record (mode %r)" % (rel, rec.get("mode")))
++    if rec.get("frozen_commit") != fz.record.commit:
++        raise PreconditionFailed("%s names frozen commit %r, PROTOCOL_FROZEN %s" % (rel, rec.get("frozen_commit"), fz.record.commit))
++    selected = rec.get("selected") or {}
++    try:
++        plan = T.training_plan(contract, selected)
++    except (ValueError, KeyError, AttributeError) as e:
++        raise PreconditionFailed("%s: selected configurations %r are not configurations of SEARCH_SPACE.json (%s)" % (
++            rel, selected, e)) from e
++    if rec.get("data_content_hashes") != content_hashes:
++        raise PreconditionFailed("%s: data content hashes differ from the data directory" % rel)
++    ck = rec.get("checkpoints") or {}
++    hexes = re.compile(r"[0-9a-f]{64}")
++    missing = [s.name for s in plan if not isinstance(ck.get(s.name), str) or not hexes.fullmatch(ck[s.name])]
++    if missing:
++        raise PreconditionFailed("%s: no checkpoint hash for %d runs (first %s)" % (rel, len(missing), missing[0]))
++    return sha
++
++
++def check_preconditions(repo_root, inputs_dir, data_dir):
++    """The three conditions, in order. Returns (Frozen, TestAuthorization); raises PreconditionFailed or a protocol
++    stop (ST12) on the first condition that fails."""
++    fz = STP.st12(repo_root, inputs_dir, data_dir)                    # condition 1 (raises ST12Error)
++    contract = C.load(fz)
++    content = fz.check_data_dir(data_dir)
++    g_sha = check_gate0_record(fz, fz.repo_root)                     # condition 2
++    s_sha = check_selection_record(fz, contract, fz.repo_root, content)   # condition 3
++    return fz, LK.TestAuthorization(fz.record.commit, g_sha, s_sha)
++
