+def callee(node):
+    f = node.func
+    if isinstance(f, ast.Name):
+        return f.id
+    if isinstance(f, ast.Attribute):
+        return f.attr
+    return None
+
+
+def enclosing(tree):
+    out = {}
+
+    def walk(n, fn):
+        for c in ast.iter_child_nodes(n):
+            name = c.name if isinstance(c, (ast.FunctionDef, ast.AsyncFunctionDef)) else fn
