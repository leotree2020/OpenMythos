++    sm, dm = fz.split_manifest, fz.data_manifest
++    per_fact = int(C.fullmatch_frozen(r"(\d+) questions per fact \(learned and unread\), TEST templates; not generated before the "
++                         r"final freeze", sm["splits"]["TEST"], "splits.TEST").group(1))
++    n, split = C.fullmatch_frozen(r"first (\d+) windows per domain with split == '(\w+)', file order; final TEST evaluation only",
++                     dm["general_text"]["test"], "general_text.test").groups()
++    return per_fact, int(n), split
