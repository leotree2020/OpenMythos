+            if (isinstance(n, ast.Name) and n.id in ("TEST_FILES", "SPLIT_FILES")) or (isinstance(n, ast.Attribute) and n.attr in ("TEST_FILES", "SPLIT_FILES")):
+                tf_uses.append((b, n.lineno, enc_of[id(n)]))
