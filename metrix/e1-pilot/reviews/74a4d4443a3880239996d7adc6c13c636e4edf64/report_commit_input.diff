++def _committed_json(repo_root, rel):
++    """JSON of a file that is committed at HEAD with no uncommitted change in the working tree."""
++    r = subprocess.run(["git", "-C", str(repo_root), "cat-file", "blob", "HEAD:%s" % rel], capture_output=True, check=False)
++    if r.returncode != 0:
++        raise PreconditionFailed("%s is not committed at HEAD" % rel)
++    wt = Path(repo_root) / rel
++    if not wt.is_file() or wt.read_bytes() != r.stdout:
++        raise PreconditionFailed("%s in the working tree differs from its committed version" % rel)
++    try:
++        return json.loads(r.stdout), FZ.sha256_hex(r.stdout)
++    except ValueError as e:
++        raise PreconditionFailed("%s does not parse: %r" % (rel, e)) from e
