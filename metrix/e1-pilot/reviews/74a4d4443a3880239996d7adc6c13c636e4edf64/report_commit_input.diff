++def compute_values(inp, contract):
++    """Numbers read by G0.1-G0.10. `inp`:
++      leakage      the Gate 0 leakage report (leakage.run_gate0)
++      all_finite   True iff every loss, score and NLL used was finite; nonfinite: list of descriptions
++      facts        facts.jsonl rows
++      N            stats.evaluation_summary of arm N
++      F, S, Y, L, A  {seed: stats.evaluation_summary} of the selected configuration (F, L, A) / F's configuration (S, Y)
++      repro        {seed: (evaluation 1, evaluation 2)} of F's selected configuration (raw evaluate_model outputs)
++    """
++    st, g = contract.statistics, contract.gate
++    facts = inp["facts"]
++    grp = S.groups(facts, st.strata)
++    learned = grp["learned"]
++    stratum_of = {f["fact_id"]: f["stratum"] for f in facts}
++    seeds = contract.training.training_seeds
++    N = inp["N"]
++
++    def cmp(x_scores, y_scores, label, seed):
++        return S.paired_bootstrap(x_scores, y_scores, learned, stratum_of, st, S.purpose(label, "DEV", seed))
++
++    def avg(arm):
++        return S.seed_average([inp[arm][s]["scores_dev"] for s in seeds])
++
++    v = {}
++    v["G0.1"] = {"leakage_result": inp["leakage"]["result"],
++                 "over_limit": sorted(c for c, x in inp["leakage"]["checks"].items() if not x["within_limit"])}
++    v["G0.2"] = {"all_finite": bool(inp["all_finite"]), "nonfinite": list(inp.get("nonfinite", []))}
++    v["G0.3"] = {"acc_dev_learned": float(N["acc_dev_learned"]), "acc_dev_unread": float(N["acc_dev_unread"]),
++                 "acc_cb": float(N["acc_cb"])}
++    for s_ in st.strata:
++        v["G0.3"]["acc_dev_learned:%s" % s_] = float(N["acc_dev_learned:%s" % s_])
++    v["G0.4"] = {"acc_cb_by_seed": {s: float(inp["F"][s]["acc_cb"]) for s in seeds}}
++    f_avg = avg("F")
++    v["G0.5"] = {"acc_avg": float(S.acc(f_avg, learned)),
++                 "delta_avg": cmp(f_avg, N["scores_dev"], "F-N", "avg"),
++                 "delta_by_seed": {s: cmp(inp["F"][s]["scores_dev"], N["scores_dev"], "F-N", s)["point"] for s in seeds}}
++    for cond, arm in (("G0.6", "S"), ("G0.7", "Y")):
++        d = cmp(avg(arm), N["scores_dev"], "%s-N" % arm, "avg")
++        v[cond] = {"point": d["point"], "ci_high": d["ci_high"], "delta_avg": d}
++    v["G0.8"] = {"checkpoints": {s: repro_compare(a, b, g) for s, (a, b) in inp["repro"].items()}}
++    v["G0.9"] = {"acc_avg": v["G0.5"]["acc_avg"]}
++    est = {}
++    for arm in ("L", "A"):
++        x_avg = avg(arm)
++        d_avg = {f: x_avg[f] - f_avg[f] for f in learned}
++        est["%s-F" % arm] = S.size_estimate(d_avg, learned, stratum_of, st, "%s-F" % arm)
++    planning = max(e["n_max"] for e in est.values())
++    v["G0.10"] = {"estimates": est, "planning_n": planning}
++    if math.isfinite(planning):
++        for arm in ("L", "A"):
++            x_avg = avg(arm)
++            d_avg = {f: x_avg[f] - f_avg[f] for f in learned}
++            est["%s-F" % arm]["halfwidth_at_planning_n"] = S.halfwidth_check(d_avg, learned, stratum_of, st,
++                                                                              "%s-F" % arm, planning)
++    return v
++
