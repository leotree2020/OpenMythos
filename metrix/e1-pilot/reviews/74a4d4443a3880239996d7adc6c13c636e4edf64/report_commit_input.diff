++    assert same["satisfied"] and same["max_score_diff"] == 0 and same["max_nll_diff"] == 0
++    # second item: top two within 1e-4 -> its prediction may flip
++    b = _ev([[-1.0, -2.0, -3.0, -4.0], [-1.00006, -1.0, -3.0, -4.0]], [3.0, 4.0])
++    r = G.repro_compare(a, b, g)
