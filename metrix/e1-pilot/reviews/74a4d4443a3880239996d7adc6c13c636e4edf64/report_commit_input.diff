++    out = []
++    with torch.no_grad():
++        for _ in range(ev.max_new_tokens):
++            t = int(model(input_ids=torch.tensor([ids])).logits[0, -1].argmax())
++            out.append(t)
++            ids.append(t)
++            if t in ev.stop_ids:
