++        dev.setdefault(r["fact_id"], []).append(r["question"])
++    learned = [f for f in facts if f["exposure"] == "learned"]
++    assert len(learned) == 120
++    pairs = mismatches = unaligned = 0
++    k_by_cell = {}
++    for f in learned:
++        want = train_answer_ids(tok, train[f["fact_id"]], f["answer"])
