++
++def evaluate_model(model, tok, data, templates, ev, device, with_em=True, with_s_mapping=False, batch_size=64):
++    """Section 5 evaluation of one model on the non-TEST data of `data` (parsed files of the data directory):
++    DEV-QA scores, TRAIN closed book, EM (DEV-QA), general DEV NLL; optionally S's own-mapping accuracy."""
++    facts, cands, dev = data["facts.jsonl"], data["candidates.json"], data["dev_qa.jsonl"]
++    out = {"dev_qa": score_qa(model, tok, dev, cands, facts, ev, device, batch_size),
++           "train_cb": score_cb(model, tok, facts, cands, templates, ev, device, batch_size),
++           "general_dev": general_nll(model, data["general_dev.jsonl"], ev, device, max(1, batch_size // 4))}
++    if with_em:
++        out["em_dev"] = em(model, tok, dev, facts, ev, device, max(1, batch_size // 2))
++    if with_s_mapping:
++        qa, cb = score_s_mapping(model, tok, facts, cands, templates, dev, data["train_S.jsonl"], ev, device, batch_size)
++        out["s_mapping_dev_qa"], out["s_mapping_cb"] = qa, cb
++    return out
