new file mode 100644
index 0000000..38107ed
--- /dev/null
+++ b/metrix/e1-pilot/src/metrix_e1/mode.py
@@ -0,0 +1,71 @@
+"""Formal mode and smoke mode (Implementation Task Order V1, section 7; section 2 red line 7).
+
+A RunMode is passed to every function whose behaviour differs between the modes. Only smoke mode may shorten
+training to a chosen number of steps or skip the GPU device checks; whatever it writes carries SMOKE_LABEL and
+never goes to the formal results directory (record.py), and no Gate 0 conclusion comes out of it (gate.py fixes the
+status to NOT_TESTED). Formal mode accepts no shortened step count: RunMode cannot be built with one
+(tests/test_train.py). Preflight mode (protocol section 8 step 2, ST11) runs the first configuration for the
+protocol's preflight step count on the A100 (device checks not skipped); only its timing is used.
+"""
+from dataclasses import dataclass
+
+FORMAL = "formal"
+SMOKE = "smoke"
+PREFLIGHT = "preflight"
+SMOKE_LABEL = "SMOKE — NOT A RESULT"
+PREFLIGHT_LABEL = "PREFLIGHT — TIMING ONLY, NOT A RESULT"
+SMOKE_GATE_NOTE = "冒烟测试，不构成结论"
+SMOKE_DEVICE_NOTE = "smoke: device check skipped"
+
+
+@dataclass(frozen=True)
+class RunMode:
+    name: str
+    smoke_steps: int = None         # steps per run in smoke mode (and the protocol's preflight steps); None in formal
+
+    def __post_init__(self):
+        if self.name == FORMAL:
+            if self.smoke_steps is not None:
+                raise ValueError("formal mode takes no shortened step count (got %r)" % (self.smoke_steps,))
+        elif self.name in (SMOKE, PREFLIGHT):
+            if type(self.smoke_steps) is not int or self.smoke_steps < 1:
+                raise ValueError("smoke mode needs a positive integer step count (got %r)" % (self.smoke_steps,))
+        else:
+            raise ValueError("unknown mode %r" % (self.name,))
+
+    @property
+    def formal(self):
+        return self.name == FORMAL
+
+    @property
+    def smoke(self):
+        return self.name == SMOKE
+
+    @property
+    def preflight(self):
+        return self.name == PREFLIGHT
+
+    @property
+    def label(self):
+        return {FORMAL: None, SMOKE: SMOKE_LABEL, PREFLIGHT: PREFLIGHT_LABEL}[self.name]
+
+    def steps(self, contract_steps):
+        """Number of optimizer steps of one training run: the contract's in formal mode; otherwise the shortened
+        count, which must be below the contract's."""
+        if self.formal:
+            return contract_steps
+        if self.smoke_steps >= contract_steps:
+            raise ValueError("%s steps %d must be fewer than the contract's %d" % (self.name, self.smoke_steps, contract_steps))
+        return self.smoke_steps
+
+
+FORMAL_MODE = RunMode(FORMAL)
+
+
+def smoke_mode(steps):
+    return RunMode(SMOKE, steps)
+
+
+def preflight_mode(contract):
+    """Protocol section 8 step 2: the preflight runs the protocol's number of steps (contract.preflight_steps)."""
+    return RunMode(PREFLIGHT, contract.preflight_steps)
diff --git a/metrix/e1-pilot/src/metrix_e1/record.py b/metrix/e1-pilot/src/metrix_e1/record.py
new file mode 100644
index 0000000..fb2717a
--- /dev/null
+++ b/metrix/e1-pilot/src/metrix_e1/record.py
@@ -0,0 +1,143 @@
+"""Experiment records of METRIX E1-PILOT.
+
+Protocol v1.1 section 10 (record template: one record per run, stopped runs included; no field may be dropped;
+compute accounting), section 0 (library versions written into the record; environment and provenance), section 7
+(device name), section 8 step 8 (the freeze record of the selected configurations, data hashes and checkpoint
+hashes before TEST). The template's field names are read from the frozen protocol text, not written here.
+
+Besides the template fields every record carries an "environment" block: interpreter, library versions (both the
+distribution metadata version, which the ST8 check compares, and torch.__version__ with its local build tag:
+DEFERRED_MINORS 1.19 AB2), CUDA / cuDNN, device, determinism settings, git state, PROTOCOL_FROZEN (SHA-256 of the
+working-tree bytes as read, and of the same bytes with CRLF -> LF: DEFERRED_MINORS 1.20 AC2), the frozen commit and
+file hashes, the data hashes, and the open interpretations (interpretations.py).
+
+Formal records go to FORMAL_RESULTS_REL inside the repository; smoke and preflight records carry their label in
+every file and are refused there (Implementation Task Order V1, section 7).
+"""
+import importlib.metadata
+import json
+import platform
+import re
+import socket
+import subprocess
+import sys
+from pathlib import Path
+
+import torch
+
+from . import frozen as FZ
+from . import interpretations as INT
+from .errors import ImplementationFail
+
+FORMAL_RESULTS_REL = FZ.PILOT_REL + "/results"
+GATE0_RECORD = "gate0_record.json"
+SELECTION_FREEZE_RECORD = "selection_freeze_record.json"
+LIBRARIES = ("torch", "transformers", "tokenizers", "huggingface_hub", "safetensors", "numpy", "pyarrow", "jinja2")
+
+
+def template_fields(protocol_text):
+    """The field names of the section 10 template (the code block after '## 10. Experiment Record Template')."""
+    m = re.search(r"## 10\. Experiment Record Template\n\n[^\n]*\n\n```\n(.*?)\n```", protocol_text, flags=re.DOTALL)
+    if m is None:
+        raise ImplementationFail("protocol section 10 template not found")
+    fields = []
+    for ln in m.group(1).split("\n"):
+        f = re.fullmatch(r"([^:]+):", ln)
+        if f is None:
+            raise ImplementationFail("protocol section 10 template line %r is not 'Field:'" % ln)
+        fields.append(f.group(1))
+    return fields
+
+
+def _git(repo_root, *args):
+    r = subprocess.run(["git", "-C", str(repo_root), *args], capture_output=True, text=True, check=False)
+    return r.stdout.strip() if r.returncode == 0 else None
+
+
+def library_versions():
+    out = {}
+    for lib in LIBRARIES:
+        try:
+            out[lib] = {"metadata": importlib.metadata.version(lib)}
+        except importlib.metadata.PackageNotFoundError:
+            out[lib] = {"metadata": None}
+    out["torch"]["__version__"] = torch.__version__
+    import transformers
+    out["transformers"]["__version__"] = transformers.__version__
+    return out
+
+
+def environment(fz, device=None, determinism=None, data_hashes=None):
+    """The environment and provenance block of a record."""
+    pf = (fz.repo_root / FZ.PROTOCOL_FROZEN_REL).read_bytes()
+    root = fz.repo_root
+    env = {
+        "python": sys.version, "python_implementation": platform.python_implementation(),
+        "platform": platform.platform(), "hostname": socket.gethostname(), "libraries": library_versions(),
+        "cuda": {"torch_cuda": torch.version.cuda, "cudnn": torch.backends.cudnn.version(),
+                 "available": torch.cuda.is_available()},
+        "device": device, "determinism": determinism,
+        "git": {"head": _git(root, "rev-parse", "HEAD"), "branch": _git(root, "rev-parse", "--abbrev-ref", "HEAD"),
+                "status_porcelain": _git(root, "status", "--porcelain")},
+        "protocol_frozen": {"version": fz.record.version, "commit": fz.record.commit,
+                            "file_sha256": dict(fz.record.file_sha256), "data_sha256": dict(fz.record.data_sha256),
+                            "PROTOCOL_FROZEN_working_tree_bytes_sha256": FZ.sha256_hex(pf),
+                            "PROTOCOL_FROZEN_lf_normalized_sha256": FZ.sha256_hex(pf.replace(b"\r\n", b"\n"))},
+        "data_hashes": data_hashes,
+        "interpretations": INT.as_records(),
+    }
+    env["git"]["dirty"] = bool(env["git"]["status_porcelain"])
+    return env
+
+
+def new_record(fz, mode, experiment_id, values, env):
+    """A record with every template field (missing values are an error: the template's fields cannot be dropped)."""
+    fields = template_fields(fz.protocol_text)
+    missing = [f for f in fields if f not in values]
+    extra = [k for k in values if k not in fields]
+    if missing or extra:
+        raise ImplementationFail("record %s: missing template fields %s, unknown fields %s" % (experiment_id, missing, extra))
+    rec = {"label": mode.label, "mode": mode.name, "template": {f: values[f] for f in fields},
+           "experiment_id": experiment_id, "environment": env}
+    if values["Experiment ID"] != experiment_id:
+        raise ImplementationFail("Experiment ID field %r differs from %r" % (values["Experiment ID"], experiment_id))
+    return rec
+
+
+def _is_formal_dir(path, repo_root):
+    p = Path(path).resolve()
+    formal = (Path(repo_root) / FORMAL_RESULTS_REL).resolve()
+    return p == formal or formal in p.parents
+
+
+def write_record(rec, path, repo_root):
+    """Write a record as JSON. A smoke or preflight record (label set) is refused inside the formal results
+    directory, and a formal record outside it is refused."""
+    path = Path(path)
+    formal_dir = _is_formal_dir(path.parent, repo_root)
+    if rec["mode"] != "formal" and formal_dir:
+        raise ImplementationFail("%s record refused in the formal results directory %s" % (rec["mode"], path.parent))
+    if rec["mode"] == "formal" and not formal_dir:
+        raise ImplementationFail("formal record must be written under %s, not %s" % (FORMAL_RESULTS_REL, path.parent))
+    if rec["mode"] != "formal" and rec.get("label") is None:
+        raise ImplementationFail("%s record without its label" % rec["mode"])
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(rec, ensure_ascii=False, indent=1, sort_keys=True, default=str) + "\n", encoding="utf-8")
+    return path
+
+
+def render_text(rec):
+    """The record in the order of the protocol template, one 'Field: value' block per field (plain text)."""
+    lines = [rec["label"]] if rec.get("label") else []
+    for k, v in rec["template"].items():
+        lines.append("%s: %s" % (k, v if isinstance(v, str) else json.dumps(v, ensure_ascii=False, default=str)))
+    return "\n".join(lines) + "\n"
+
+
+def gate0_record_path(repo_root):
+    return Path(repo_root) / FORMAL_RESULTS_REL / GATE0_RECORD
+
+
+def selection_freeze_path(repo_root):
+    return Path(repo_root) / FORMAL_RESULTS_REL / SELECTION_FREEZE_RECORD
+
diff --git a/metrix/e1-pilot/src/metrix_e1/stats.py b/metrix/e1-pilot/src/metrix_e1/stats.py
new file mode 100644
index 0000000..d4928e0
--- /dev/null
+++ b/metrix/e1-pilot/src/metrix_e1/stats.py
@@ -0,0 +1,190 @@
+"""Metrics and statistics of METRIX E1-PILOT.
+
+Protocol v1.1 section 5 (Score_split(f) = mean over the fact's questions; Acc = mean over facts; AllCorrect, FPR,
+Spill, ImmediateGain, dNLL, PPL degradation) and section 6 (the unit is the fact: question scores are aggregated to
+one score per fact before anything is resampled; paired, stratified bootstrap; 10,000 replicates; 95% CI = 2.5th and
+97.5th percentiles; seed-average = per-fact mean over the 3 seeds, then bootstrap; rng_rule(BOOTSTRAP_SEED, purpose));
+section 8 G0.10 (size estimate). Choices left open by the protocol: interpretations B10-B13.
+
+Accuracies are exact fractions (fractions.Fraction) so that ties in the selection of section 7 are exact; the
+bootstrap works on floats.
+"""
+import math
+from fractions import Fraction
+
+from . import frozen as FZ
+
+
+# ------------------------------------------------------------------------------------------ fact level (5)
+
+def fact_scores(rows, key="correct"):
+    """Score_split(f) = (1/|Q_split(f)|) * sum_q 1[...]: one exact fraction per fact (aggregation = mean). `rows`: one
+    row per (fact, question) with a boolean `key`."""
+    num, den = {}, {}
+    for r in rows:
+        f = r["fact_id"]
+        num[f] = num.get(f, 0) + (1 if r[key] else 0)
+        den[f] = den.get(f, 0) + 1
+    return {f: Fraction(num[f], den[f]) for f in num}
+
+
+def all_correct(rows, key="correct"):
+    """AllCorrect(f) = product over the fact's questions of correct(f, q)."""
+    out = {}
+    for r in rows:
+        out[r["fact_id"]] = out.get(r["fact_id"], True) and bool(r[key])
+    return {f: Fraction(int(v)) for f, v in out.items()}
+
+
+def groups(facts, strata):
+    """Fact ids in facts.jsonl order: learned, unread, and learned / unread per stratum."""
+    g = {"learned": [f["fact_id"] for f in facts if f["exposure"] == "learned"],
+         "unread": [f["fact_id"] for f in facts if f["exposure"] == "unread"]}
+    for st in strata:
+        for e in ("learned", "unread"):
+            g["%s:%s" % (e, st)] = [f["fact_id"] for f in facts if f["exposure"] == e and f["stratum"] == st]
+    return g
+
+
+def acc(scores, fact_ids):
+    """Acc(arm, split, G) = (1/|G|) sum_{f in G} Score_split(f)."""
+    missing = [f for f in fact_ids if f not in scores]
+    if missing or not fact_ids:
+        raise ValueError("Acc over %d facts: %d have no score" % (len(fact_ids), len(missing)))
+    return sum((scores[f] for f in fact_ids), Fraction(0)) / len(fact_ids)
+
+
+def seed_average(per_seed):
+    """Per-fact mean of the scores of several seeds (section 6 'seed-average')."""
+    keys = set(per_seed[0])
+    if any(set(s) != keys for s in per_seed):
+        raise ValueError("seeds score different facts")
+    return {f: sum((s[f] for s in per_seed), Fraction(0)) / len(per_seed) for f in keys}
+
+
+def dnll(rows_arm, rows_n):
+    """dNLL(arm) = mean over domains of mean over the domain's windows of NLL_arm(w) - NLL_N(w); domains in the order
+    of the rows. Returns (dNLL, PPL_degradation% = 100 (exp(dNLL) - 1))."""
+    base = {(r["domain"], r["doc_id"]): r["nll"] for r in rows_n}
+    if len(base) != len(rows_n) or len(rows_arm) != len(rows_n):
+        raise ValueError("NLL rows of the arm and of N do not match")
+    by_dom = {}
+    for r in rows_arm:
+        by_dom.setdefault(r["domain"], []).append(r["nll"] - base[(r["domain"], r["doc_id"])])
+    d = sum(sum(v) / len(v) for v in by_dom.values()) / len(by_dom)
+    return d, 100.0 * (math.exp(d) - 1.0)
+
+
+# --------------------------------------------------------------------------------------------- bootstrap (6)
+
+def purpose(comparison, split, seed):
+    """B12: '<X>-<Y>:<split>:<seed or avg>'."""
+    return "%s:%s:%s" % (comparison, split, seed)
+
+
+def percentile(sorted_values, p):
+    """B11: linear interpolation at position (B - 1) * p / 100 of the sorted values."""
+    pos = (len(sorted_values) - 1) * p / 100.0
+    lo = math.floor(pos)
+    hi = min(lo + 1, len(sorted_values) - 1)
+    return sorted_values[lo] + (sorted_values[hi] - sorted_values[lo]) * (pos - lo)
+
+
+def stratified_draws(d_by_stratum, n_boot, rng):
+    """B10: n_boot replicates; per replicate, per stratum in the given order, rng.choices(values, k=len(values))."""
+    out = []
+    strata = list(d_by_stratum.values())
+    for _ in range(n_boot):
+        drawn = []
+        for vals in strata:
+            drawn += rng.choices(vals, k=len(vals))
+        out.append(drawn)
+    return out
+
+
+def _by_stratum(d, fact_ids, stratum_of, strata):
+    return {st: [float(d[f]) for f in fact_ids if stratum_of[f] == st] for st in strata}
+
+
+def paired_bootstrap(score_x, score_y, fact_ids, stratum_of, st, purpose_text):
+    """Section 6: d_f = Score_X(f) - Score_Y(f) over `fact_ids` (both arms on the same resampled facts); stratified
+    resampling within each stratum; Delta* = mean(d_f); 95% CI from the percentiles. Returns a dict."""
+    d = {f: score_x[f] - score_y[f] for f in fact_ids}
+    by = _by_stratum(d, fact_ids, stratum_of, st.strata)
+    if sum(len(v) for v in by.values()) != len(fact_ids):
+        raise ValueError("facts outside the strata %s" % (st.strata,))
+    rng = FZ.rng_rule(st.bootstrap_seed, purpose_text)
+    reps = sorted(sum(x) / len(x) for x in stratified_draws(by, st.n_boot, rng))
+    point = sum((d[f] for f in fact_ids), Fraction(0)) / len(fact_ids)
+    return {"purpose": purpose_text, "point": float(point), "point_exact": str(point), "n_facts": len(fact_ids),
+            "n_per_stratum": {k: len(v) for k, v in by.items()}, "replicates": st.n_boot,
+            "ci_low": percentile(reps, st.ci_low_pct), "ci_high": percentile(reps, st.ci_high_pct)}
+
+
+# ------------------------------------------------------------------------------------------- G0.10 (8; B13)
+
+def sample_sd(values):
+    n = len(values)
+    m = sum(values) / n
+    return math.sqrt(sum((v - m) ** 2 for v in values) / (n - 1))
+
+
+def required_n(sigma, delta, z_sum):
+    return math.ceil((z_sum * sigma / delta) ** 2) if math.isfinite(sigma) else math.inf
+
+
+def size_estimate(d_avg, fact_ids, stratum_of, st, comparison, split="DEV"):
+    """G0.10 for one comparison: sigma_d of the seed-average paired differences, its bootstrap percentiles, the
+    required n for each delta and each sigma value, and the CI half-width obtained when n facts are resampled."""
+    by = _by_stratum(d_avg, fact_ids, stratum_of, st.strata)
+    vals = [v for vs in by.values() for v in vs]
+    sigma = sample_sd(vals)
+    rng = FZ.rng_rule(st.bootstrap_seed, purpose("sigma:" + comparison, split, "avg"))
+    sig_reps = sorted(sample_sd(x) for x in stratified_draws(by, st.n_boot, rng))
+    sigmas = {"p%g" % st.ci_low_pct: percentile(sig_reps, st.ci_low_pct), "point": sigma,
+              "p%g" % st.ci_high_pct: percentile(sig_reps, st.ci_high_pct)}
+    n_table = {"%s|delta=%g" % (k, dl): required_n(s, dl, st.z_sum) for k, s in sigmas.items() for dl in st.deltas}
+    return {"comparison": comparison, "sigma": sigmas, "n": n_table, "n_max": max(n_table.values()),
+            "finite": all(math.isfinite(v) for v in list(sigmas.values()) + list(n_table.values()))}
+
+
+def halfwidth_check(d_avg, fact_ids, stratum_of, st, comparison, n, split="DEV"):
+    """B13 (report only): resample n facts (ceil(n / number of strata) per stratum) n_boot times and report the
+    half-width of the 95% CI of the mean."""
+    by = _by_stratum(d_avg, fact_ids, stratum_of, st.strata)
+    per = math.ceil(n / len(by))
+    rng = FZ.rng_rule(st.bootstrap_seed, purpose("halfwidth:" + comparison, split, "avg:%d" % n))
+    reps = []
+    for _ in range(st.n_boot):
+        drawn = []
+        for vals in by.values():
+            drawn += rng.choices(vals, k=per)
+        reps.append(sum(drawn) / len(drawn))
+    reps.sort()
+    return {"n": n, "per_stratum": per, "halfwidth": (percentile(reps, st.ci_high_pct) - percentile(reps, st.ci_low_pct)) / 2}
+
+
+# ------------------------------------------------------------------------------------- per-evaluation summary
+
+def evaluation_summary(ev_out, facts, strata):
+    """Section 5 summary of one evaluation (evaluate.evaluate_model output): exact fact scores and accuracies.
+    Keys: scores_dev (Score_DEV(f) for all 160 facts), scores_cb (CB(f) for the 120 learned facts), acc_dev_learned,
+    acc_dev_unread, acc_dev_<exposure>:<stratum>, acc_cb, all_correct_dev, fpr_dev, em_dev_learned / em_dev_unread
+    (if EM was run), and the general DEV NLL rows."""
+    g = groups(facts, strata)
+    sd = fact_scores(ev_out["dev_qa"])
+    scb = fact_scores(ev_out["train_cb"])
+    allc = all_correct(ev_out["dev_qa"])
+    out = {"scores_dev": sd, "scores_cb": scb, "acc_dev_learned": acc(sd, g["learned"]),
+           "acc_dev_unread": acc(sd, g["unread"]), "acc_cb": acc(scb, g["learned"]),
+           "all_correct_dev": allc, "fpr_dev": acc(allc, g["unread"]), "general_dev": ev_out["general_dev"]}
+    for st in strata:
+        for e in ("learned", "unread"):
+            out["acc_dev_%s:%s" % (e, st)] = acc(sd, g["%s:%s" % (e, st)])
+    if "em_dev" in ev_out:
+        se = fact_scores(ev_out["em_dev"], key="em")
+        out["em_dev_learned"], out["em_dev_unread"] = acc(se, g["learned"]), acc(se, g["unread"])
+    if "s_mapping_dev_qa" in ev_out:
+        out["s_mapping_dev_learned"] = acc(fact_scores(ev_out["s_mapping_dev_qa"]), g["learned"])
+        out["s_mapping_cb"] = acc(fact_scores(ev_out["s_mapping_cb"]), g["learned"])
+    return out
diff --git a/metrix/e1-pilot/src/metrix_e1/stops.py b/metrix/e1-pilot/src/metrix_e1/stops.py
new file mode 100644
index 0000000..4d9286f
--- /dev/null
+++ b/metrix/e1-pilot/src/metrix_e1/stops.py
@@ -0,0 +1,148 @@
+"""Stop conditions ST1-ST13 of METRIX E1-PILOT.
+
+Protocol v1.1 section 11 (events and actions), section 9 (statuses), section 8 (the steps the stops belong to).
+Each check raises Stop (an errors.ProtocolStop) when its event holds; the exception carries the stop code, the
+section 9 status, the action text of the frozen protocol row (read from the frozen protocol, not written here) and
+two flags: `void_pilot` (ST9, ST13: every result of the pilot is void) and `exclude_config` (ST6 outside the selected
+configurations and the controls: the configuration is dropped from selection, section 7). Statuses that section 11
+does not state are interpretation B16. Thresholds come from metrix_e1.contract.
+
+ST12 is raised by metrix_e1.frozen and metrix_e1.data (errors.ST12Error); st12() runs those checks.
+"""
+import math
+
+from . import contract as C
+from . import data as D
+from . import frozen as FZ
+from .errors import ProtocolStop, ST8Error, ST12Error
+
+CODES = tuple("ST%d" % i for i in range(1, 14))
+
+
+class Stop(ProtocolStop):
+    def __init__(self, code, status, action, message, reason=None, void_pilot=False, exclude_config=False):
+        super().__init__(code, status, "%s [%s]%s" % (message, action, " reason %s" % reason if reason else ""))
+        self.action = action
+        self.reason = reason
+        self.void_pilot = void_pilot
+        self.exclude_config = exclude_config
+
+
+def action(fz, code):
+    """The action cell of the frozen protocol row of `code`."""
+    cells = C.protocol_row(fz.protocol_text, code).split(" | ")
+    if len(cells) != 2:
+        raise ValueError("protocol row %s does not have an event and an action cell" % code)
+    return cells[1]
+
+
+def st1(fz, leakage_report):
+    """Step 2: any leakage check over its limit -> stop; no training; IMPLEMENTATION_FAIL."""
+    over = sorted(c for c, x in leakage_report["checks"].items() if not x["within_limit"])
+    if over or leakage_report["result"] != "PASS":
+        raise Stop("ST1", "IMPLEMENTATION_FAIL", action(fz, "ST1"), "leakage over limit: %s" % over)
+
+
+def st2(fz, g03_satisfied):
+    """Step 3: N does not satisfy G0.3 -> stop; no training; PIPELINE_NOT_QUALIFIED (recalibration)."""
+    if not g03_satisfied:
+        raise Stop("ST2", "PIPELINE_NOT_QUALIFIED", action(fz, "ST2"), "N does not satisfy G0.3")
+
+
+def st3(fz, contract, acc_cb_f101, acc_dev_learned_f101):
+    """Step 4: F's selected configuration (search seed) has Acc_CB below the ST3 bound or Acc(F, DEV-QA, learned)
+    below the ST3 bound -> stop; no L, A, S, Y (B16: PIPELINE_NOT_QUALIFIED with a section 9 reason)."""
+    s = contract.stops
+    if acc_cb_f101 < s.st3_cb_min or acc_dev_learned_f101 < s.st3_acc_min:
+        reason = "OPTIMIZATION_FAIL" if acc_cb_f101 < s.st3_cb_min else "OPTIMIZATION_OR_CAPACITY_UNRESOLVED"
+        raise Stop("ST3", "PIPELINE_NOT_QUALIFIED", action(fz, "ST3"),
+                   "positive control: Acc_CB %.4f (min %g), Acc(F, DEV-QA, learned) %.4f (min %g)" % (
+                       acc_cb_f101, s.st3_cb_min, acc_dev_learned_f101, s.st3_acc_min), reason=reason)
+
+
+def st4(fz, g07_satisfied):
+    """Y does not satisfy G0.7 -> stop; no TEST."""
+    if not g07_satisfied:
+        raise Stop("ST4", "PIPELINE_NOT_QUALIFIED", action(fz, "ST4"), "Y does not satisfy G0.7",
+                   reason="IMPLEMENTATION_FAIL")
+
+
+def st5(fz, g06_satisfied):
+    """S does not satisfy G0.6 -> stop; no TEST."""
+    if not g06_satisfied:
+        raise Stop("ST5", "PIPELINE_NOT_QUALIFIED", action(fz, "ST5"), "S does not satisfy G0.6",
+                   reason="IMPLEMENTATION_FAIL")
+
+
+def st6(fz, values, what, selected_or_control):
+    """Any non-finite value in a training run or an evaluation -> stop that run. In a selected configuration or a
+    control: IMPLEMENTATION_FAIL; otherwise the configuration is excluded from selection (section 7)."""
+    bad = [x for x in values if not math.isfinite(x)]
+    if bad:
+        if selected_or_control:
+            raise Stop("ST6", "IMPLEMENTATION_FAIL", action(fz, "ST6"), "%s: %d non-finite values" % (what, len(bad)))
+        raise Stop("ST6", None, action(fz, "ST6"), "%s: %d non-finite values; configuration excluded" % (
+            what, len(bad)), exclude_config=True)
+
+
+def st7(fz, contract, used_seconds, next_seconds=0.0):
+    """Cumulative GPU wall-clock above the limit, or a next step that would take it above -> stop and report (B16:
+    BLOCKED)."""
+    limit = contract.stops.st7_hours * 3600.0
+    if used_seconds > limit or used_seconds + next_seconds > limit:
+        raise Stop("ST7", "BLOCKED", action(fz, "ST7"), "GPU wall-clock %.0f s used + %.0f s next > limit %.0f s" % (
+            used_seconds, next_seconds, limit))
+
+
+def st8(fz, contract, device_name, total_memory, libraries=None):
+    """Environment not as section 0 / section 7 require: device name prefix, total memory, library versions."""
+    tr = contract.training
+    if device_name is None or not device_name.startswith(tr.device_prefix) or total_memory < tr.device_min_gib * 2 ** 30:
+        raise Stop("ST8", "BLOCKED", action(fz, "ST8"), "device %r with %r bytes; required: name starting %r and at "
+                   "least %d GiB" % (device_name, total_memory, tr.device_prefix, tr.device_min_gib))
+    try:
+        FZ.check_library_versions(fz.data_manifest, libraries)
+    except ST8Error as e:
+        raise Stop("ST8", "BLOCKED", action(fz, "ST8"), str(e)) from e
+
+
+def st9(fz, recorded_name, current_name):
+    """The full device name read at the start of a run differs from the recorded one -> the whole batch is void;
+    BLOCKED; restart from section 8 step 3 on a machine with the recorded name."""
+    if recorded_name is None or current_name != recorded_name:
+        raise Stop("ST9", "BLOCKED", action(fz, "ST9"), "device name %r, recorded %r" % (current_name, recorded_name),
+                   void_pilot=True)
+
+
+def st10(fz, test_leakage_report, executor_l6, auditor_l6):
+    """Step 8: any TEST part of L3-L6 over its limit, or the L6 TEST counts of Executor and data-auditor differ ->
+    stop; no TEST evaluation; BLOCKED; report to the Owner."""
+    over = sorted(c for c, x in test_leakage_report["checks"].items() if not x["within_limit"])
+    if over or test_leakage_report["result"] != "PASS" or auditor_l6 is None or executor_l6 != auditor_l6:
+        raise Stop("ST10", "BLOCKED", action(fz, "ST10"), "TEST part over limit %s; L6 TEST Executor %r, data-auditor %r" % (
+            over, executor_l6, auditor_l6))
+
+
+def st11(fz, contract, estimate_hours):
+    """Preflight estimate above the ST11 bound -> stop; report to the Owner (B16: BLOCKED)."""
+    if not math.isfinite(estimate_hours) or estimate_hours > contract.stops.st11_hours:
+        raise Stop("ST11", "BLOCKED", action(fz, "ST11"), "preflight estimate %.3f h > %g h" % (
+            estimate_hours, contract.stops.st11_hours))
+
+
+def st12(repo_root=None, inputs_dir=None, data_dir=None):
+    """ST12 at the start of a step: PROTOCOL_FROZEN, the four frozen files (git cat-file), and, when given, the
+    inputs and the data directory (data.verify). Raises errors.ST12Error. Returns the loaded Frozen."""
+    fz = FZ.load(repo_root)
+    if data_dir is not None:
+        if inputs_dir is None:
+            raise ST12Error("the data directory is checked against its regeneration from the inputs; no inputs given")
+        D.verify(fz, inputs_dir, data_dir)
+    return fz
+
+
+def st13(fz, test_read_before_freeze):
+    """TEST read before the configurations are frozen -> IMPLEMENTATION_FAIL; the whole pilot is void."""
+    if test_read_before_freeze:
+        raise Stop("ST13", "IMPLEMENTATION_FAIL", action(fz, "ST13"), "TEST read before the configuration freeze",
+                   void_pilot=True)
