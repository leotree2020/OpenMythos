+        sys.stdout.flush()
+    print(json.dumps({"repo_head": subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True,
+                                                  text=True).stdout.strip()}))
+
+
+if __name__ == "__main__":
+    main()
