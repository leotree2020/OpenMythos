+"""METRIX E1-PILOT implementation package (protocol v1.1, frozen commit recorded in metrix/e1-pilot/PROTOCOL_FROZEN).
+
+Implementation Task Order V1 (metrix/e1-pilot/tasks/IMPLEMENTATION_TASK_ORDER_V1.md), section 5. Every module names
+the protocol section it implements in its docstring. Values of the protocol (thresholds, hyperparameters, seeds,
+hashes, templates) are read from the frozen files through metrix_e1.frozen, not written into the code.
+"""
diff --git a/metrix/e1-pilot/src/metrix_e1/_cli.py b/metrix/e1-pilot/src/metrix_e1/_cli.py
new file mode 100644
index 00000000..74585037
--- /dev/null
+++ b/metrix/e1-pilot/src/metrix_e1/_cli.py
@@ -0,0 +1,29 @@
+"""Exit convention of every judging command of the package (Implementation Task Order V1, section 5 "检查脚本"):
+a check that does not pass prints "RESULT: FAIL" and exits non-zero; an exception does the same. The same guard
+as the round 6 check scripts (metrix/e1-pilot/reports/round5/l6_check.py, run_guarded).
+"""
+import sys
+import traceback
+
+
+def run_guarded(main):
+    """Run main(). Exit codes 0 and 1 raised by main() pass through (main() prints its own RESULT line before them);
+    any other SystemExit (sys.exit("message"), an argparse error) and any exception print RESULT: FAIL and exit
+    non-zero."""
+    try:
+        main()
+    except SystemExit as e:
+        if e.code is None or (type(e.code) is int and e.code in (0, 1)):
+            raise
+        sys.stdout.flush()
+        if type(e.code) is not int:
+            print(e.code, file=sys.stderr)
+            sys.stderr.flush()
+        print("RESULT: FAIL")
+        sys.exit(e.code if type(e.code) is int else 1)
+    except BaseException:
+        sys.stdout.flush()
+        traceback.print_exc()
+        sys.stderr.flush()
+        print("RESULT: FAIL")
+        sys.exit(1)
diff --git a/metrix/e1-pilot/src/metrix_e1/data.py b/metrix/e1-pilot/src/metrix_e1/data.py
