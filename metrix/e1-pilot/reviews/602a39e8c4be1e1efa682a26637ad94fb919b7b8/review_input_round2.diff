@@ -0,0 +1,95 @@
+"""Implementation Task Order V1, section 6 item 1: the four frozen hashes regenerated by data.py are identical
+(protocol v1.1 sections 2.2, 2.5, 2.6, 2.7; PROTOCOL_FROZEN). Also: data.py's outputs are byte-identical to those of
+the reference scripts in reports/round*/ that it was ported from (section 5, data.py row), and the Gate 0 part of the
+leakage checks passes on them (protocol section 3)."""
+import json
+import os
+import re
+import subprocess
+import sys
+
+from metrix_e1 import data as D
+from metrix_e1 import frozen as FZ
+from metrix_e1 import leakage as LK
+
+from conftest import PILOT
+
+# The prefixes named in the Task Order (section 5, data.py row); the full values come from PROTOCOL_FROZEN.
+TASK_ORDER_PREFIXES = {"facts": "406c8801", "train_S": "686fdd2f", "candidates": "e5d15c99", "anchor_texts": "8828bc4f"}
+
+
+def test_four_frozen_hashes(fz, generated):
+    got = fz.content_hashes(generated["dir"])                      # read back from the written files
+    assert sorted(got) == sorted(TASK_ORDER_PREFIXES)
+    for key, sha in got.items():
+        assert sha == fz.data_hash(key), key
+        assert sha.startswith(TASK_ORDER_PREFIXES[key]), key
+    assert fz.check_data_dir(generated["dir"]) == got
+
+
+def test_files_are_canonical(generated):
+    """Written in the canonical form of protocol section 0, so byte_sha256 == canonical_sha256 for every file."""
+    for name, h in D.file_hashes(generated["dir"]).items():
+        assert h["byte_sha256"] == h["canonical_sha256"], name
+
+
+def test_counts_and_ratio(fz, generated):
+    """Row counts of 2.3 / 2.6 / 2.7 (from the frozen manifests) and the Y / F token counts that protocol 2.6 states
+    for DATA_SEED (read from the frozen protocol text: "F 1,889 token,Y 2,260 token")."""
+    p = D.params(fz)
+    total, learned = fz.data_manifest["facts"]["total"], fz.data_manifest["facts"]["learned"]
+    assert generated["info"]["rows"] == {
+        "facts.jsonl": total, "train_F.jsonl": learned, "train_S.jsonl": learned, "train_Y.jsonl": 2 * learned,
+        "dev_qa.jsonl": total * p.dev_per_fact, "candidates.json": total,
+        "general_dev.jsonl": p.general_dev_per_domain * len(p.general_domains), "anchor_text.jsonl": p.anchor_n_docs}
+    m = re.findall(r"F ([\d,]+) token,Y ([\d,]+) token", fz.protocol_text)
+    assert len(m) == 1
+    r = generated["info"]["y_ratio"]
+    assert (r["F_tokens"], r["Y_tokens"]) == tuple(int(x.replace(",", "")) for x in m[0])
+    assert generated["info"]["general_dev"]["decoded_rows"] == generated["info"]["rows"]["general_dev.jsonl"]
+
+
+def test_no_test_file(generated):
+    assert not any((generated["dir"] / n).exists() for n in D.TEST_FILES)
+
+
+def _run(args, **kw):
+    env = dict(os.environ, HF_HUB_OFFLINE="1", PYTHONHASHSEED="0")
+    r = subprocess.run([sys.executable, "-I", *map(str, args)], capture_output=True, text=True, env=env, cwd=PILOT, **kw)
+    assert r.returncode == 0, r.stdout + r.stderr
+    return r.stdout
+
+
+def test_byte_identical_to_reference_scripts(inputs_dir, generated, tmp_path):
+    """reports/round2/anchor_check.py, gen_facts.py, reports/round7/gen_s_cands.py and reports/round5/l6_check.py,
+    run on the same inputs, give byte-identical facts, anchor texts, train_S.jsonl, candidates.json and general DEV
+    windows."""
+    rep = PILOT / "reports"
+    tok = inputs_dir / "qwen_tokenizer"
+    _run([rep / "round2/anchor_check.py", "--manifest", "DATA_MANIFEST.json", "--tokenizer-dir", tok,
+          "--cache-dir", inputs_dir / "anchor_source", "--anchor-out", tmp_path / "anchor.json"])
+    _run([rep / "round2/gen_facts.py", "--manifest", "DATA_MANIFEST.json", "--tokenizer-dir", tok,
+          "--anchor", tmp_path / "anchor.json", "--out", tmp_path / "facts.json"])
+    _run([rep / "round7/gen_s_cands.py", "--facts", tmp_path / "facts.json", "--data-manifest", "DATA_MANIFEST.json",
+          "--split-manifest", "SPLIT_MANIFEST.json", "--out-dir", tmp_path / "sc"])
+    _run([rep / "round5/l6_check.py", "--eval-sets", PILOT.parents[1] / "research/mini_mythos/stage1/results/r1/eval_sets.jsonl",
+          "--parcae-tokenizer", inputs_dir / "parcae_tokenizer/tokenizer.json", "--manifest", "DATA_MANIFEST.json",
+          "--tokenizer-dir", tok, "--anchor", tmp_path / "anchor.json", "--general-out", tmp_path / "general.json"])
+    files = generated["files"]
+    facts = FZ.read_jsonl(generated["dir"] / "facts.jsonl")
+    assert (tmp_path / "facts.json").read_bytes() == FZ.canonical_bytes(facts)
+    assert (tmp_path / "sc/train_S.jsonl").read_bytes() == files["train_S.jsonl"]
+    assert (tmp_path / "sc/candidates.json").read_bytes() == files["candidates.json"]
+    ref_anchor = json.loads((tmp_path / "anchor.json").read_text(encoding="utf-8"))["texts"]
+    ours = FZ.read_jsonl(generated["dir"] / "anchor_text.jsonl")
+    assert FZ.canonical_bytes(ref_anchor) == FZ.canonical_bytes([r["text"] for r in ours])
+    ref_general = json.loads((tmp_path / "general.json").read_text(encoding="utf-8"))
+    ours = FZ.read_jsonl(generated["dir"] / "general_dev.jsonl")
+    assert FZ.canonical_bytes([{k: g[k] for k in ("domain", "doc_id", "ids", "text")} for g in ref_general]) == \
+        FZ.canonical_bytes(ours)
+
+
+def test_leakage_gate0_passes(fz, generated):
+    report = LK.run_gate0(fz.split_manifest, LK.load_data(generated["dir"]))
+    assert report["result"] == "PASS", report
+    assert set(report["checks"]) == set(LK.CHECKS)
