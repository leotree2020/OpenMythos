+def _cli(*args):
+    env = dict(os.environ, PYTHONPATH=str(SRC))
+    return subprocess.run([sys.executable, "-m", "metrix_e1.data", *map(str, args)], capture_output=True, text=True,
+                          env=env, cwd=PILOT)
