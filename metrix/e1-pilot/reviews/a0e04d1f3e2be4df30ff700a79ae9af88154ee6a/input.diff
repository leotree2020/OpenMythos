+bash $L "$O" git status --short --untracked-files=all
+bash $L "$O" bash -c "$STATE"
+bash $L "$O" $E $PY -m metrix_e1.data generate --inputs "$IN" --out "$SC/c2d_data"
+bash $L "$O" $E $PY -m metrix_e1.data verify --inputs "$IN" --data "$SC/c2d_data"
+bash $L "$O" $E $PY -m metrix_e1.test_data --inputs "$IN" --data "$SC/c2d_data" --out "$SC/c2d_test_out"
+bash $L "$O" bash -c "ls -la $SC/c2d_test_out 2>&1; ls $SC/c2d_data; git status --short -- metrix/e1-pilot/results 2>&1; ls metrix/e1-pilot/results 2>&1"
