+STATE='git diff --quiet -- metrix/e1-pilot/src metrix/e1-pilot/tests metrix/e1-pilot/run_pilot.py && echo WORKTREE_EQUALS_INDEX_FOR_SRC_TESTS_RUN_PILOT; git diff --cached HEAD -- metrix/e1-pilot/src metrix/e1-pilot/tests metrix/e1-pilot/run_pilot.py | sha256sum; git write-tree; git ls-files -s -- metrix/e1-pilot/src metrix/e1-pilot/tests metrix/e1-pilot/run_pilot.py; sha256sum metrix/e1-pilot/reports/impl_c/c2_mutate_fix3.py metrix/e1-pilot/reports/impl_c/c2d_checks.sh'
