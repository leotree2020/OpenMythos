+bash $L "$O" bash -c "echo 'old placeholders, private method, home venv, pending wording in the RUNBOOK (expected none):'; grep -n '<名称>\|_state()\|~/metrix-venv\|待 Review Gate\|待决\|report_only\|b17_plus' $RB; echo \"grep exit \$?\""
