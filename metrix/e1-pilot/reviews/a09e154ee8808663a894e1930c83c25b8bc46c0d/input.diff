+#!/usr/bin/env bash
+# Stage C, C4 code commit (Review Gate ruling of 2026-11-27, tasks/IMPL_C4_RULING.md item 1): the checks of the staged
+# tree, recorded unedited (stdout+stderr merged) by reports/round5/logrun.sh.
