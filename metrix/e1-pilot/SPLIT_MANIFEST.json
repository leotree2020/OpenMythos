  "template_freeze": {
    "normalization": "replace {E} by <ENTITY> and {A} by <ANSWER>, lowercase, replace every character outside [a-z0-9<> ] by a space, collapse spaces",
    "identity": "normalized_sha256 of every template; template_set_sha256 = SHA-256 of the sorted normalized_sha256 values joined by '\\n'",
    "template_set_sha256": "0ba13680f2194eba980bda56d3fb598a6e17ebb0e0779abdb47f53291cf506bb"
  },
  "candidates": {
    "way": 4,
    "pool": "answers of the other facts with the same relation, stratum and exposure class (learned / unread)",
    "draw": "3 distractors without replacement and the order of the 4 candidates from rng_rule(CANDIDATE_SEED, 'cand:<fact_id>')",
    "shared_by": "all templates, splits and arms of the fact",
    "duplicates": "forbidden",
    "exposure_matching": "every candidate of a learned fact occurs exactly once in the training corpus of F, L, A, S and Y; every candidate of an unread fact occurs zero times",
    "candidate_mapping_sha256": null
  },
  "leakage_checks": {
    "L1_template_hash": {
      "rule": "the TRAIN, DEV, TEST and Y template sets have pairwise disjoint normalized_sha256 values",
      "limit": 0,
      "authoring_result": {
        "duplicate_normalized_hashes": []
      }
    },
    "L2_template_ngram": {
      "rule": "Jaccard overlap of word 4-gram sets of normalized templates, every pair from different sets",
      "limit": 0.25,
      "authoring_result": {
        "max": 0.2,
        "pair": [
          "capital.TRAIN.1",
          "capital.DEV.1"
        ]
      }
    },
    "L3_unread_fact": {
      "rule": "occurrences (case-insensitive substring) of every unread entity and every unread answer in train_F, train_S, train_Y and anchor_text",
      "limit": 0
    },
    "L4_question_text": {
      "rule": "instantiated DEV / TEST question strings occurring verbatim in any training corpus",
      "limit": 0
    },
    "L5_identity": {
      "rule": "learned and unread fact_id sets disjoint; all 320 entity / answer strings distinct",
      "limit": 0
    },
    "L6_general_text": {
      "rule": "word 13-grams shared between anchor_text and general_dev / general_test",
      "limit": 0
    },
    "command": "python -m metrix.e1_pilot.check_leakage --data <DATA_DIR> --split-manifest metrix/e1-pilot/SPLIT_MANIFEST.json --out <DATA_DIR>/leakage_report.json",
    "exit_code": "0 only if every check is within its limit",
    "test_split": "L1 and L2 use templates only; L3-L5 run on TEST questions only after test_qa.jsonl is generated"
  },
  "hashing": {
    "encoding": "UTF-8",
    "serialization": "json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(',', ':'), allow_nan=False)",
    "jsonl": "one canonical object per line, joined by '\\n', one final '\\n'",
    "hash": "SHA-256",
    "byte_sha256": "SHA-256 of the file bytes exactly as stored (LF newlines)",
    "canonical_sha256": "SHA-256 of the canonical serialization of the parsed content; identifies the content independently of formatting"
  },
  "split_sha256": {
    "train_F.jsonl": null,
    "train_S.jsonl": null,
    "train_Y.jsonl": null,
    "dev_qa.jsonl": null,
    "test_qa.jsonl": null
  }
