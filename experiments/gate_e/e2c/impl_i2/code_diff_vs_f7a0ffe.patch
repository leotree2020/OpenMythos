+        json.dump(obj, f, indent=1)
+
+
+def bodies(rng, n, held=False):
+    out = []
+    while len(out) < n:
+        (l1, l2), (d1, d2) = rng.sample(SYN, 2), rng.sample(DIG, 2)
+        b = f"{l1}={d1};{l2}={d2};"
+        if T.held(T.key(T.stmts(b))) == held and b not in out:
+            out.append(b)
+    return out
