+            hits += len(KEY_LIKE.findall(f.read().decode("utf-8", "replace")))
+        n += 1
+    for t in texts:
+        hits += len(KEY_LIKE.findall(t.decode("utf-8", "replace") if isinstance(t, bytes) else t))
+        n += 1
+    return {"files": n, "key_like_hits": hits}
