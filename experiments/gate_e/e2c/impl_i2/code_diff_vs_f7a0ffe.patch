+def write_once_or_same(path, data):
+    try:
+        write_once(path, data)
+    except FileExistsError:
+        if open(path, "rb").read() != data:
+            raise S2Stop(3, f"INTEGRITY FAILURE: {os.path.basename(path)} exists with other content (written once)")
