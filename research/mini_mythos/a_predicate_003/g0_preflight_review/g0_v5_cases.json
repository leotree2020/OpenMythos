  {
   "id": "A",
   "title": "summary complete and verified, no g0_closed.json",
   "narrative": "the process stopped after P6 verified the summary and before K2 (crash point X1); the files are complete",
   "run_dir": {
    "entry": "real_dir",
    "closed": "absent",
    "closed_runid": "na",
    "criteria_vs_tool": "na",
    "criteria_vs_summary": "na",
    "summary": "na",
    "summary_binding": "na",
    "evidence": "na",
    "evidence_binding": "na",
    "tmp": "absent",
    "stray_closure_names": false,
    "manual_disposition": false
   },
   "global": {
    "root_manual_disposition": false,
    "root_listing": "complete",
    "live_marker_process": false
   },
   "files_present": [
    "registry.jsonl",
    "g0_evidence.json",
    "g0_summary.json"
   ],
   "expected": {
    "result": "BLOCKED",
    "reasons": [
     "NO_CLOSED"
    ],
    "human_actions": [
     "H1"
    ]
   },
   "note": "V4: closed because g0_summary.json exists -> the next real run would not have been refused (the F-23 defect)"
  },
