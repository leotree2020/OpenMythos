{
 "id": "g0-v5-closure-cases",
 "note": "static design-review cases derived by hand from closure.preflight.rules; not tests of G0 code; not an experiment result",
 "defaults": {
  "run_dir": {
   "entry": "real_dir",
   "closed": "ok",
   "closed_runid": "match",
   "criteria_vs_tool": "match",
   "criteria_vs_summary": "match",
   "summary": "ok",
   "summary_binding": "match",
   "evidence": "ok",
   "evidence_binding": "match",
   "tmp": "identical",
   "stray_closure_names": false,
   "manual_disposition": false
  },
  "global": {
   "root_manual_disposition": false,
   "root_listing": "complete",
   "live_marker_process": false
  }
 },
